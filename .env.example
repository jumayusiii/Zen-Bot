# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: put a server ID here for instant slash-command updates while testing.
# If omitted, commands are registered globally for every server (up to an hour to appear).
GUILD_ID=

# Optional: your application/client ID. If omitted it is read from the bot token.
CLIENT_ID=

# The site watched by /sitestatus, /uptime and the background monitor.
# Changing this starts a fresh uptime history.
SITE_URL=https://habbo.gd

# Optional: display name used in status embeds. Defaults to the site hostname.
SITE_NAME=habbo.gd

# Optional: logo attached to /sitestatus. Leave blank to disable it.
SITE_LOGO_URL=https://cdn.habbo.gd/cms/habbo/logo.png

# Optional: how often to sample uptime, in seconds (default 300, minimum 60).
SITE_MONITOR_INTERVAL_SECONDS=300

# Optional: the Playing rich presence text.
PRESENCE_TEXT=I am Legend.

# Optional: post server counts to Discord bot lists every 30 minutes.
# top.gg: create a token at https://top.gg/account/tokens
TOPGG_TOKEN=

# Discord Bot List: generate a token on the bot's admin page.
DISCORDBOTLIST_TOKEN=
