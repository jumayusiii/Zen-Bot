# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: only used by `npm run deploy:guild` for single-server development.
# Production deploys with `npm run deploy` (global) and clears guild copies so
# commands never appear twice in the picker.
GUILD_ID=

# Optional: your application/client ID. If omitted it is read from the bot token.
CLIENT_ID=1564936469305364480

# Optional: the Playing rich presence text.
PRESENCE_TEXT=use /helplist!

# Optional: post server counts to Discord bot lists every 30 minutes.
# top.gg: create a token at https://top.gg/account/tokens
TOPGG_TOKEN=

# Discord Bot List: generate a token on the bot's admin page.
DISCORDBOTLIST_TOKEN=

# Optional: enables the beta /chatgpt command. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model used by /chatgpt.
OPENAI_MODEL=gpt-6-luna
